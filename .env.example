# PostgreSQL usado pelo Docker Compose e pela aplicacao local
POSTGRES_DB=unescshare
POSTGRES_USER=unescshare
POSTGRES_PASSWORD=senha123
POSTGRES_PORT=5432

# Portas publicadas pelo Compose de apresentacao no host
API_PORT=8080
FRONTEND_PORT=5173

# Aplicacao Spring Boot
DB_HOST=localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev
SEED_ENABLED=true

# JWT: gere uma chave exclusiva com `openssl rand -base64 32` e preencha no .env.
# Nunca utilize uma chave de teste ou publique a chave real.
JWT_SECRET=
JWT_TTL=15m
JWT_ISSUER=unesc-share
JWT_AUDIENCE=unesc-share-api

# Administrador inicial: somente dev, opt-in e sem credenciais padrao.
# Use email ainda nao cadastrado e senha exclusiva; desative apos a primeira carga.
ADMIN_SEED_ENABLED=false
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Diretorio privado de metainfo .torrent, nunca conteudo academico; nao servir como recurso estatico.
TORRENT_STORAGE_DIR=./data/torrents

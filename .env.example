# PostgreSQL usado pelo Docker Compose e pela aplicacao local
POSTGRES_DB=unescshare
POSTGRES_USER=unescshare
POSTGRES_PASSWORD=senha123
POSTGRES_PORT=5432

# Aplicacao Spring Boot
DB_HOST=localhost
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev
SEED_ENABLED=true

# JWT: gere uma chave exclusiva com `openssl rand -base64 32` e preencha no .env.
# Nunca utilize uma chave de teste ou publique a chave real.
JWT_SECRET=
JWT_TTL=15m
JWT_ISSUER=unesc-share
JWT_AUDIENCE=unesc-share-api
